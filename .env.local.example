# ─────────────────────────────────────────────────────────────
#  Email settings for the "Send An Enquiry" form.
#  Copy this file to  .env.local  and fill in the values.
#  NEVER commit .env.local — it is already in .gitignore.
# ─────────────────────────────────────────────────────────────

# --- Gmail (recommended, free) -------------------------------
# 1. Turn on 2-Step Verification on the Gmail account
# 2. Go to  https://myaccount.google.com/apppasswords
# 3. Create an App Password named "Website" and paste the
#    16-character code into SMTP_PASS (remove the spaces)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=musclefittness@gmail.com
SMTP_PASS=

# Where enquiries are delivered (defaults to site.email if blank)
ENQUIRY_TO=musclefittness@gmail.com

# Shown as the sender. For Gmail this must equal SMTP_USER.
ENQUIRY_FROM=musclefittness@gmail.com
